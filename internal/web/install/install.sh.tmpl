#!/bin/sh
# redrop CLI installer. Usage: curl -fsSL {{.Base}}/install.sh | sh
# Options (env): REDROP_INSTALL_DIR=/custom/bin
#   REDROP_TOKEN=rdp_...  also log in with this token after installing
#   (the dashboard's Tokens page shows this one-line setup command).
set -eu

BASE="{{.Base}}"

err() { printf 'redrop install: %s\n' "$*" >&2; exit 1; }

# Take the token out of the environment before running anything else, so no
# child process (curl, uname, the CLI itself) inherits it. The CLI treats
# REDROP_TOKEN as an override of the saved login. Unsetting the local name
# first drops any export attribute it may have inherited.
unset rd_token
rd_token="${REDROP_TOKEN:-}"
unset REDROP_TOKEN

case "$(uname -s)" in
  Linux) os=linux ;;
  Darwin) os=darwin ;;
  *) err "unsupported OS $(uname -s); on Windows run: irm $BASE/install.ps1 | iex" ;;
esac
case "$(uname -m)" in
  x86_64|amd64) arch=amd64 ;;
  arm64|aarch64) arch=arm64 ;;
  *) err "unsupported CPU $(uname -m)" ;;
esac

if [ -n "${REDROP_INSTALL_DIR:-}" ]; then
  dir="$REDROP_INSTALL_DIR"
elif [ "$(id -u)" = 0 ]; then
  dir=/usr/local/bin
else
  dir="$HOME/.local/bin"
fi
mkdir -p "$dir"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT INT TERM
file="redrop-$os-$arch"

fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -qO "$2" "$1"
  else err "curl or wget is required"; fi
}

fetch "$BASE/download/$file" "$tmp/$file" || err "download failed"
fetch "$BASE/download/SHA256SUMS" "$tmp/SHA256SUMS" || err "checksum download failed"

want=$(grep " $file\$" "$tmp/SHA256SUMS" | cut -d' ' -f1)
[ -n "$want" ] || err "no checksum for $file"
if command -v sha256sum >/dev/null 2>&1; then got=$(sha256sum "$tmp/$file" | cut -d' ' -f1)
else got=$(shasum -a 256 "$tmp/$file" | cut -d' ' -f1); fi
[ "$want" = "$got" ] || err "checksum mismatch for $file"

chmod 0755 "$tmp/$file"
bin="$dir/redrop"
mv "$tmp/$file" "$bin"
printf 'Installed redrop to %s\n' "$bin"
"$bin" version || true

case ":$PATH:" in
  *":$dir:"*) ;;
  *) printf '\nNote: %s is not on your PATH. Add it, e.g.:\n  echo '\''export PATH="%s:$PATH"'\'' >> ~/.profile\n' "$dir" "$dir" ;;
esac

if [ -z "$rd_token" ]; then
  printf '\nNext: create an API token in the dashboard (%s/tokens), then run:\n  redrop login --url %s\n' "$BASE" "$BASE"
  printf 'The Tokens page also shows a one-line command that installs and logs in.\n'
  exit 0
fi

# printf is a shell builtin, so the token reaches the CLI on stdin only and
# never appears in any process's argv.
printf '\n'
if ! printf '%s' "$rd_token" | "$bin" login --url "$BASE" --token-stdin; then
  rd_token=
  err "redrop is installed at $bin, but login failed (see above). To retry, run: $bin login --url $BASE
and paste the token at the prompt (create a new one at $BASE/tokens if needed)."
fi
rd_token=
# Confirm the saved login (no token in the environment now).
"$bin" --url "$BASE" whoami >/dev/null ||
  err "redrop is installed at $bin, but the saved login does not work. Retry with: $bin login --url $BASE"
printf '\nredrop is set up. Next: run `redrop guide` to see how to share files and pages.\n'
